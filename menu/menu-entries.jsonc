"omacar": {"icon":"󰄋","label":"OmaCar","aliases":["car","obd","diagnostics"],"description":"OBD-II diagnostics, monitoring and repair advice"},
"omacar.open": {"icon":"󰏌","label":"Open OmaCar","aliases":["workshop"],"action":"__CMD__ open"},
"omacar.scan": {"icon":"󰚗","label":"Full System Scan","aliases":["scan","codes"],"description":"Every control unit, one report","action":"omarchy-launch-floating-terminal-with-presentation '__CMD__ scan'"},
"omacar.ai": {"icon":"󱚝","label":"Ask the Advisor","aliases":["ai","diagnose","advisor"],"description":"What is actually wrong with this car","action":"omarchy-launch-floating-terminal-with-presentation '__CMD__ ai'"},
"omacar.watch": {"icon":"󰛐","label":"Watchdog","aliases":["monitor","alerts"],"description":"Tells you when the car needs you to know something"},
"omacar.watch.start": {"icon":"󰐊","label":"Start Watching","checked":"systemctl --user is-active --quiet omacar-watch.service","action":"systemctl --user start omacar-watch.service"},
"omacar.watch.stop": {"icon":"󰓛","label":"Stop Watching","action":"systemctl --user stop omacar-watch.service"},
"omacar.watch.list": {"icon":"󰋼","label":"Recent Alerts","action":"omarchy-launch-floating-terminal-with-presentation '__CMD__ watch list'"},
"omacar.live": {"icon":"󰓅","label":"Live Readings","aliases":["live","gauges"],"action":"omarchy-launch-floating-terminal-with-presentation '__CMD__ live'"},
"omacar.doctor": {"icon":"󰗋","label":"Diagnose Connection","aliases":["doctor"],"action":"omarchy-launch-floating-terminal-with-presentation '__CMD__ doctor'"},
"omacar.sim": {"icon":"󰙨","label":"Simulated Car","aliases":["sim","demo"],"description":"A whole 2015 CR-Z in software — no adapter needed"},
"omacar.sim.start": {"icon":"󰐊","label":"Start Simulator","checked":"systemctl --user is-active --quiet omacar-sim.service","action":"systemctl --user start omacar-sim.service"},
"omacar.sim.stop": {"icon":"󰓛","label":"Stop Simulator","action":"systemctl --user stop omacar-sim.service"},
"omacar.bench": {"icon":"󰙨","label":"Bench Emulator","aliases":["bench","emulator"],"action":"omarchy-launch-floating-terminal-with-presentation '__CMD__ bench start'"},
